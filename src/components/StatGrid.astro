---
import type { Stat } from '@/data/types';
import { t, type Lang } from '@/lib/i18n';

interface Props {
  stats: Stat[];
  lang: Lang;
}

const { stats, lang } = Astro.props;
---

<div class="stat-grid">
  {
    stats.map((s) => (
      <div class="stat" data-reveal>
        <div class="stat__value">
          {s.value}
          {s.unit && <span class="unit">{s.unit}</span>}
        </div>
        <div class="stat__label">{t(s.label, lang)}</div>
      </div>
    ))
  }
</div>
