---
import { siteConfig } from '@/data/site';
import { langPath, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const author = t(siteConfig.author, lang);
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const altHref = pathname.replace(new RegExp(`^/${lang}`), `/${otherLang}`);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={langPath(lang, '/')} aria-label={author}>
      <span class="brand__mark">{siteConfig.brandMark}</span>
      <span class="brand__name">{author}</span>
    </a>

    <div class="lang-switch" role="group" aria-label="Language">
      <a href={lang === 'en' ? pathname : altHref} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      <a href={lang === 'zh' ? pathname : altHref} aria-current={lang === 'zh' ? 'page' : undefined}>中文</a>
    </div>
  </div>
</header>
