---
import { siteConfig } from '@/data/site';
import { langPath, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const author = t(siteConfig.author, lang);
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const altHref = pathname.replace(new RegExp(`^/${lang}`), `/${otherLang}`);

const isActive = (href: string): boolean => {
  if (href === '/') return pathname === `/${lang}` || pathname === `/${lang}/`;
  return pathname.startsWith(`/${lang}${href}`);
};
const currentFor = (href: string): 'page' | undefined => (isActive(href) ? 'page' : undefined);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={langPath(lang, '/')} aria-label={author}>
      <span class="brand__mark">{siteConfig.brandMark}</span>
      <span class="brand__name">{author}</span>
      <span class="brand__sub mono hide-mobile">LLM · Agents</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        siteConfig.nav.map((item) => (
          <a
            href={langPath(lang, item.href)}
            aria-current={currentFor(item.href)}
          >
            {t(item.label, lang)}
          </a>
        ))
      }
    </nav>

    <div class="lang-switch" role="group" aria-label="Language">
      <a href={lang === 'en' ? pathname : altHref} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      <a href={lang === 'zh' ? pathname : altHref} aria-current={lang === 'zh' ? 'page' : undefined}>中文</a>
    </div>

    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-label="Menu" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {
      siteConfig.nav.map((item) => (
        <a
          href={langPath(lang, item.href)}
          aria-current={currentFor(item.href)}
          data-mobile-link
        >
          {t(item.label, lang)}
        </a>
      ))
    }
    <div class="lang-row">
      <div class="lang-switch" role="group" aria-label="Language">
        <a href={lang === 'en' ? pathname : altHref} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        <a href={lang === 'zh' ? pathname : altHref} aria-current={lang === 'zh' ? 'page' : undefined}>中文</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 720) setOpen(false);
    });
  }
</script>
