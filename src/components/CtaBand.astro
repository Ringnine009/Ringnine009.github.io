---
import type { L } from '@/data/types';
import { t, type Lang } from '@/lib/i18n';

interface Props {
  heading: L;
  sub?: L;
  primary?: { label: L; href: string; external?: boolean };
  secondary?: { label: L; href: string; external?: boolean };
  emailLine?: string;
  lang: Lang;
}

const { heading, sub, primary, secondary, emailLine, lang } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta-band" data-reveal>
      <h2>{t(heading, lang)}</h2>
      {sub && <p>{t(sub, lang)}</p>}
      <div class="cta-band__actions">
        {primary && (
          <a
            class="btn btn--primary"
            href={primary.href}
            {...(primary.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {t(primary.label, lang)}
          </a>
        )}
        {secondary && (
          <a
            class="btn btn--secondary"
            href={secondary.href}
            {...(secondary.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {t(secondary.label, lang)}
          </a>
        )}
      </div>
      {emailLine && (
        <div class="email-line">
          <a href={`mailto:${emailLine}`}>{emailLine}</a>
        </div>
      )}
    </div>
  </div>
</section>
