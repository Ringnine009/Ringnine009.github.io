---
import type { L } from '@/data/types';
import { t, type Lang } from '@/lib/i18n';

interface SkillItem {
  label: L;
  pct: number;
  note?: L;
}

interface Props {
  items: SkillItem[];
  lang: Lang;
}

const { items, lang } = Astro.props;
---

<div>
  {
    items.map((s) => (
      <div class="skill">
        <span class="skill__label">{t(s.label, lang)}</span>
        <span class="skill__track">
          <span class="skill__fill" style={`--w:${s.pct}%`}></span>
        </span>
        <span class="skill__pct">{s.pct}%</span>
      </div>
    ))
  }
</div>
