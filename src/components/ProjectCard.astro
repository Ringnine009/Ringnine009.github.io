---
import type { Project } from '@/data/types';
import { t, type Lang } from '@/lib/i18n';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const href =
  project.kind === 'research' ? `/${lang}/research` : `/${lang}/projects/${project.slug}`;
const status = project.status ? t(project.status, lang) : null;
---

<article class="card card--interactive" data-reveal>
  <div class="proj-card__top">
    <span class="proj-card__icon" aria-hidden="true">{project.glyph}</span>
    <h3 class="proj-card__name">
      <a href={href}>{project.name}</a>
    </h3>
    <div class="proj-card__badges">
      {status && <span class="badge badge--primary">{status}</span>}
    </div>
  </div>

  <p class="proj-card__summary">{t(project.summary, lang)}</p>

  <div class="proj-card__tags">
    {project.tech.slice(0, 5).map((tech) => <span class="chip">{tech}</span>)}
  </div>

  <div class="proj-card__foot">
    <span class="link-arrow">
      {t(project.links.internal, lang)}
      <span class="arr" aria-hidden="true">→</span>
    </span>
    {project.kind === 'project' && (
      <span class="mono">{project.slug}</span>
    )}
  </div>
</article>
