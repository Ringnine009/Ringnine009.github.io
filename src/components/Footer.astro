---
import { siteConfig, GITHUB_URL, CONTACT_EMAIL } from '@/data/site';
import { langPath, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [col1, col2] = siteConfig.footer.columns;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a class="brand" href={langPath(lang, '/')} style="margin-bottom:14px">
          <span class="brand__mark">{siteConfig.brandMark}</span>
          <span class="brand__name">{t(siteConfig.author, lang)}</span>
        </a>
        <p class="site-footer__blurb">{t(siteConfig.footer.blurb, lang)}</p>
      </div>
      <div>
        <h4>{t(col1.heading, lang)}</h4>
        <ul>
          {col1.links.map((link) => (
            <li>
              <a href={link.external ? link.href : langPath(lang, link.href)}>
                {t(link.label, lang)}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4>{t(col2.heading, lang)}</h4>
        <ul>
          {col2.links.map((link) => (
            <li>
              <a href={link.external ? link.href : langPath(lang, link.href)}>
                {t(link.label, lang)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>{t(siteConfig.footer.bottom, lang)}</span>
      <span class="mono">
        {siteConfig.footer.builtWith.en} · {CONTACT_EMAIL} · {GITHUB_URL.replace('https://', '')}
      </span>
    </div>
  </div>
</footer>
