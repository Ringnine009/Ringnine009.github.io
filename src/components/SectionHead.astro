---
import type { L } from '@/data/types';
import { t, type Lang } from '@/lib/i18n';

interface Props {
  kicker?: L;
  title: L;
  desc?: L;
  /** optional trailing link: { label, href } */
  link?: { label: L; href: string };
  lang: Lang;
}

const { kicker, title, desc, link, lang } = Astro.props;
const hasLink = Boolean(link);
---

<div class="section-head">
  <div>
    {kicker && <div class="section-head__kicker">{t(kicker, lang)}</div>}
    <h2>{t(title, lang)}</h2>
    {desc && <p class="section-head__desc">{t(desc, lang)}</p>}
  </div>
  {hasLink && (
    <a class="section-head__link" href={link!.href}>
      {t(link!.label, lang)}
      <span aria-hidden="true">→</span>
    </a>
  )}
</div>
