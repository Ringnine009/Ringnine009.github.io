---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { PROJECTS } from '@/data/projects';
import { homeContent } from '@/data/home';
import { siteConfig } from '@/data/site';
import { langPath, t, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/`;
const c = homeContent;
const title = `${t(siteConfig.author, lang)} — LLM Engineer & Multi-Agent Researcher`;
const description = t(siteConfig.seo.description, lang);
---

<Base lang={lang} title={title} description={description} path={path}>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="container">
      <div class="hero__head" data-reveal>
        <h1 class="hero__title">
          {t(c.hero.title, lang)}
          <span class="accent">{t(c.hero.titleAccent, lang)}</span>
          {t(c.hero.titleSuffix, lang)}
        </h1>
        <p class="hero__sub">{t(c.hero.sub, lang)}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={langPath(lang, '/projects')}>
            {t(c.hero.ctaPrimary, lang)}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href={langPath(lang, '/research')}>
            {t(c.hero.ctaSecondary, lang)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROJECTS ===================== -->
  <section class="section section--flush">
    <div class="container">
      <div class="project-list">
        {PROJECTS.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </div>
  </section>
</Base>
