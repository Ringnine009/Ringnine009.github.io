---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { researchContent as c } from '@/data/research';
import { siteConfig } from '@/data/site';
import { t, langPath, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/research`;
const title = `${t(c.title, lang)}${t(siteConfig.seo.titleSuffix, lang)}`;
const description = t(c.abstract.body[0], lang);
const doi = `https://doi.org/${c.meta.doi}`;
---

<Base lang={lang} title={title} description={description} path={path} ogType="article">
  <PageHero
    kicker={c.kicker}
    title={c.title}
    lede={{
      en: 'A published study on making LLM agents reason socially — open access.',
      zh: '已发表研究：让 LLM 智能体具备社会推理能力——开放获取。',
    }}
    badges={[{ en: 'TNS Vol.174', zh: 'TNS Vol.174' }, { en: 'Open access', zh: '开放获取' }]}
    lang={lang}
  />

  <!-- ============ PAPER META ============ -->
  <section class="section section--flush">
    <div class="container">
      <div class="paper-block" data-reveal>
        <div class="paper-block__title">{t(c.title, lang)}</div>
        <div class="paper-block__meta">
          <div>{t(c.meta.venue, lang)} · {t(c.meta.volume, lang)}</div>
          <div>{t(c.meta.conference, lang)}</div>
          <div>{t(c.meta.supervisor, lang)}</div>
          <div>{t(c.meta.date, lang)} · {t(c.meta.role, lang)}</div>
          <a class="paper-block__doi" href={doi} target="_blank" rel="noopener noreferrer">
            DOI: {c.meta.doi}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ABSTRACT ============ -->
  <section class="detail-section">
    <div class="container detail-section__grid">
      <div>
        <div class="detail-section__label">
          <span class="num">01</span>
          {t(c.abstract.kicker, lang)}
        </div>
      </div>
      <div class="detail-section__body">
        {c.abstract.body.map((b) => <p>{t(b, lang)}</p>)}
      </div>
    </div>
  </section>

  <!-- ============ METHOD ============ -->
  <section class="detail-section">
    <div class="container detail-section__grid">
      <div>
        <div class="detail-section__label">
          <span class="num">02</span>
          {t(c.methods.kicker, lang)}
        </div>
        <h3 style="margin-top:6px">{t(c.methods.heading, lang)}</h3>
      </div>
      <div class="detail-section__body">
        <figure class="diagram-figure">
          <img class="diagram" src="/diagrams/research.svg" alt={t(c.methods.architecture, lang)} loading="lazy" />
          <figcaption>{t(c.methods.architecture, lang)}</figcaption>
        </figure>
        <div style="margin-top:20px;display:grid;gap:14px">
          {c.methods.points.map((p) => (
            <div class="card card--plain" style="padding:16px 18px">
              <h4 style="margin-bottom:6px;color:var(--primary-hover)">{t(p.title, lang)}</h4>
              <p style="font-size:0.8125rem">{t(p.body, lang)}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RESULTS ============ -->
  <section class="detail-section">
    <div class="container detail-section__grid">
      <div>
        <div class="detail-section__label">
          <span class="num">03</span>
          {t(c.results.kicker, lang)}
        </div>
        <h3 style="margin-top:6px">{t(c.results.heading, lang)}</h3>
      </div>
      <div class="detail-section__body">
        <div class="card card--plain" style="padding:0;overflow:hidden">
          <table class="data-table">
            <thead>
              <tr>
                {c.results.table.headers.map((h) => <th>{t(h, lang)}</th>)}
              </tr>
            </thead>
            <tbody>
              {c.results.table.rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td class={typeof cell === 'string' ? 'num' : ''}>{typeof cell === 'string' ? cell : t(cell, lang)}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="card card--plain" style="padding:0;overflow:hidden;margin-top:24px">
          <div style="padding:16px 18px 0">
            <h4 style="margin:0 0 4px">{t(c.results.allConfigs.heading, lang)}</h4>
            <p style="font-size:0.8125rem;line-height:1.7;color:var(--ink-muted);margin:0">
              {t(c.results.allConfigs.note, lang)}
            </p>
          </div>
          <table class="data-table">
            <thead>
              <tr>
                {c.results.allConfigs.headers.map((h) => <th>{t(h, lang)}</th>)}
              </tr>
            </thead>
            <tbody>
              {c.results.allConfigs.rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td class={typeof cell === 'string' ? (row.indexOf(cell) === 0 ? '' : 'num') : 'num'}>
                      {typeof cell === 'string' ? cell : t(cell, lang)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PAPER INFO / CITATION ============ -->
  <section class="detail-section">
    <div class="container detail-section__grid">
      <div>
        <div class="detail-section__label">
          <span class="num">04</span>
          {t(c.paperInfo.kicker, lang)}
        </div>
      </div>
      <div class="detail-section__body">
        <div class="paper-block" style="border-left-color:var(--primary)">
          <p style="font-size:0.8125rem;line-height:1.8;color:var(--ink-muted)">
            {t(c.paperInfo.citation, lang)}
          </p>
          <div style="margin-top:14px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <a class="btn btn--primary" href={doi} target="_blank" rel="noopener noreferrer">
              {t(c.paperInfo.readOnline, lang)}
              <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="btn btn--secondary" href="/papers/dl34010.pdf" download>
              {t(c.paperInfo.download, lang)}
            </a>
            <span class="chip">{t(c.paperInfo.doiLabel, lang)}: {c.meta.doi}</span>
          </div>
          <div class="bibtex" style="margin-top:14px">
            <button type="button" class="bibtex__toggle" aria-expanded="false">
              <span>BibTeX</span>
              <span class="bibtex__caret" aria-hidden="true">▸</span>
            </button>
            <pre class="bibtex__pre" hidden>{t(c.paperInfo.bibtex, lang)}</pre>
          </div>
          <script>
            const toggles = document.querySelectorAll('.bibtex__toggle');
            toggles.forEach((btn) => {
              btn.addEventListener('click', () => {
                const pre = btn.parentElement?.querySelector('.bibtex__pre');
                if (!pre) return;
                const open = pre.hidden;
                pre.hidden = !open;
                btn.setAttribute('aria-expanded', String(open));
                btn.querySelector('.bibtex__caret')!.textContent = open ? '▾' : '▸';
              });
            });
          </script>
          <p style="margin-top:12px;color:var(--ink-tertiary);font-size:0.75rem">
            {t(c.paperInfo.note, lang)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading={c.cta.heading}
    sub={c.cta.sub}
    primary={{ label: c.cta.primary, href: langPath(lang, '/projects/paperflow') }}
    secondary={{ label: { en: 'Back to home', zh: '返回首页' }, href: langPath(lang, '/') }}
    lang={lang}
  />
</Base>
