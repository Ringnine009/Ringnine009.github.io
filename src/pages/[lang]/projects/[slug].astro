---
import Base from '@/layouts/Base.astro';
import ArchPlaceholder from '@/components/ArchPlaceholder.astro';
import StatGrid from '@/components/StatGrid.astro';
import TodoNote from '@/components/TodoNote.astro';
import { getProject, DETAILED_PROJECTS } from '@/data/projects';
import { siteConfig } from '@/data/site';
import { t, langPath, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of ['en', 'zh'] as Lang[]) {
    for (const p of DETAILED_PROJECTS) {
      paths.push({ params: { lang, slug: p.slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const project = getProject(slug);

if (!project) {
  return Astro.redirect(`/${lang}/projects`);
}

const path = `/${lang}/projects/${slug}`;
const title = `${project.name} — ${t(project.tagline, lang)}${t(siteConfig.seo.titleSuffix, lang)}`;
const description = t(project.summary, lang);
const d = project.detail;

// Section order (task spec): problem → approach → architecture → highlights
// → results → demo → tech stack → GitHub → my role
const sections = [
  { id: 'problem', num: '01', label: d.problem.heading ?? { en: 'Problem', zh: '问题' } },
  { id: 'approach', num: '02', label: d.approach.heading ?? { en: 'Approach', zh: '方法' } },
  { id: 'architecture', num: '03', label: { en: 'Architecture', zh: '架构' } },
  { id: 'highlights', num: '04', label: { en: 'Highlights', zh: '亮点' } },
  { id: 'results', num: '05', label: { en: 'Results', zh: '结果' } },
  { id: 'demo', num: '06', label: { en: 'Demo', zh: '演示' } },
  { id: 'stack', num: '07', label: { en: 'Tech stack', zh: '技术栈' } },
  { id: 'github', num: '08', label: { en: 'Source', zh: '源码' } },
  { id: 'role', num: '09', label: d.role.heading ?? { en: 'My role', zh: '我的角色' } },
] as const;
---

<Base lang={lang} title={title} description={description} path={path} ogType="article">
  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <div class="container">
      <nav class="page-hero__crumbs" aria-label="Breadcrumb">
        <a href={langPath(lang, '/')}>{t({ en: 'Home', zh: '首页' }, lang)}</a>
        <span aria-hidden="true">/</span>
        <a href={langPath(lang, '/projects')}>{t({ en: 'Projects', zh: '项目' }, lang)}</a>
        <span aria-hidden="true">/</span>
        <span>{project.name}</span>
      </nav>
      <div class="section-head__kicker">{t({ en: 'Case study', zh: '案例研究' }, lang)}</div>
      <h1 class="page-hero__title">{project.name}</h1>
      <p class="page-hero__lede">{t(project.tagline, lang)}</p>
      <div class="page-hero__meta">
        {project.status && <span class="badge badge--primary">{t(project.status, lang)}</span>}
        <span class="badge badge--outline">{t({ en: 'Project', zh: '项目' }, lang)}</span>
        {project.tech.slice(0, 4).map((tech) => <span class="chip">{tech}</span>)}
      </div>
      <div style="margin-top:24px;display:flex;flex-wrap:wrap;gap:12px">
        {project.links.github && (
          <a
            class="btn btn--primary"
            href={project.links.github.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t(project.links.github.label, lang)}
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
        )}
        {project.links.demo && (
          <a
            class="btn btn--secondary"
            href={project.links.demo.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t(project.links.demo.label, lang)}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  {project.stats.length > 0 && (
    <section class="section section--flush" style="padding-bottom:8px">
      <div class="container">
        <StatGrid stats={project.stats} lang={lang} />
      </div>
    </section>
  )}

  <!-- ============ DETAIL SECTIONS ============ -->
  {
    sections.map((sec) => {
      const body = (() => {
        switch (sec.id) {
          case 'problem':
            return (
              <div class="detail-section__body">
                {d.problem.body.map((b) => (
                  <p>{t(b, lang)}</p>
                ))}
              </div>
            );
          case 'approach':
            return (
              <div class="detail-section__body">
                {d.approach.body.map((b) => (
                  <p>{t(b, lang)}</p>
                ))}
              </div>
            );
          case 'architecture':
            return (
              <div class="detail-section__body">
                <ArchPlaceholder caption={d.architecture} glyph="◫" lang={lang} />
              </div>
            );
          case 'highlights':
            return (
              <div class="detail-section__body">
                <ul>
                  {d.highlights.map((h) => <li>{t(h, lang)}</li>)}
                </ul>
              </div>
            );
          case 'results':
            return (
              <div class="detail-section__body">
                <ul>
                  {d.results.map((r) => (
                    <li class="todo">{t(r, lang)}</li>
                  ))}
                </ul>
              </div>
            );
          case 'demo':
            return (
              <div class="detail-section__body">
                {d.demoMedia ? (
                  <div class="demo-media">
                    <video controls preload="metadata" poster={d.demoMedia.gif} style="width:100%;border-radius:10px;border:1px solid var(--hairline);background:#000">
                      <source src={d.demoMedia.video} type="video/mp4" />
                    </video>
                    <div style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px">
                      {d.demoMedia.shots.map((s) => (
                        <img src={s} alt="" loading="lazy" style="width:100%;border-radius:8px;border:1px solid var(--hairline)" />
                      ))}
                    </div>
                  </div>
                ) : (
                  <div class="arch-box" data-reveal>
                    <span class="mono" aria-hidden="true">▶</span>
                    {t(d.demo, lang)}
                  </div>
                )}
              </div>
            );
          case 'stack':
            return (
              <div class="detail-section__body">
                <ul>
                  {d.techStack.map((s) => <li>{t(s, lang)}</li>)}
                </ul>
              </div>
            );
          case 'github':
            return (
              <div class="detail-section__body">
                <p>{t(d.github, lang)}</p>
                {project.links.github?.url && (
                  <div style="margin-top:12px">
                    <a class="chip" href={project.links.github.url} target="_blank" rel="noopener noreferrer">
                      {project.links.github.url}
                    </a>
                  </div>
                )}
              </div>
            );
          case 'role':
            return (
              <div class="detail-section__body">
                {d.role.body.map((b) => <p>{t(b, lang)}</p>)}
                {d.roleTags.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px">
                    {d.roleTags.map((tag) => <span class="badge badge--outline">{t(tag, lang)}</span>)}
                  </div>
                )}
              </div>
            );
        }
      })();

      return (
        <section class="detail-section" id={sec.id}>
          <div class="container detail-section__grid">
            <div>
              <div class="detail-section__label">
                <span class="num">{sec.num}</span>
                {t(sec.label, lang)}
              </div>
            </div>
            {body}
          </div>
        </section>
      );
    })
  }

  <!-- ============ TODO NOTES ============ -->
  {d.todos.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="detail-section__label" style="margin-bottom:12px">
          {t({ en: 'Before launch', zh: '上线前' }, lang)}
        </div>
        <div style="display:grid;gap:10px">
          {d.todos.map((todo) => <TodoNote note={todo} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ============ NEXT PROJECT ============ -->
  {
    (() => {
      const idx = DETAILED_PROJECTS.findIndex((p) => p.slug === slug);
      const next = DETAILED_PROJECTS[(idx + 1) % DETAILED_PROJECTS.length];
      return (
        <section class="section" style="padding-top:0">
          <div class="container">
            <a class="card card--interactive" style="padding:20px;flex-direction:row;align-items:center;justify-content:space-between;gap:16px" href={`/${lang}/projects/${next.slug}`}>
              <div>
                <div class="detail-section__label" style="margin-bottom:6px">
                  {t({ en: 'Next project', zh: '下一个项目' }, lang)}
                </div>
                <h3 style="font-family:var(--font-mono);font-size:1.0625rem;font-weight:600">
                  {next.name}
                </h3>
                <p style="color:var(--ink-subtle);font-size:0.8125rem;margin-top:4px">{t(next.tagline, lang)}</p>
              </div>
              <span class="link-arrow hide-mobile" aria-hidden="true">
                <span class="arr">→</span>
              </span>
            </a>
          </div>
        </section>
      );
    })()
  }
</Base>
