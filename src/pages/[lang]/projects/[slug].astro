---
import Base from '@/layouts/Base.astro';
import StatGrid from '@/components/StatGrid.astro';
import { getProject, DETAILED_PROJECTS } from '@/data/projects';
import { siteConfig } from '@/data/site';
import { t, langPath, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of ['en', 'zh'] as Lang[]) {
    for (const p of DETAILED_PROJECTS) {
      paths.push({ params: { lang, slug: p.slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const project = getProject(slug);

if (!project) {
  return Astro.redirect(`/${lang}/projects`);
}

const path = `/${lang}/projects/${slug}`;
const title = `${project.name} — ${t(project.tagline, lang)}${t(siteConfig.seo.titleSuffix, lang)}`;
const description = t(project.summary, lang);
const d = project.detail;
---

<Base lang={lang} title={title} description={description} path={path} ogType="article">
  <!-- ============ HERO: title + links (left), demo video (right) ============ -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__grid">
        <div class="page-hero__main">
          <nav class="page-hero__crumbs" aria-label="Breadcrumb">
            <a href={langPath(lang, '/')}>{t({ en: 'Home', zh: '首页' }, lang)}</a>
            <span aria-hidden="true">/</span>
            <a href={langPath(lang, '/projects')}>{t({ en: 'Projects', zh: '项目' }, lang)}</a>
            <span aria-hidden="true">/</span>
            <span>{project.name}</span>
          </nav>
          <h1 class="page-hero__title">{project.name}</h1>
          <p class="page-hero__lede">{t(project.summary, lang)}</p>
          <div class="page-hero__meta">
            {project.status && <span class="badge badge--primary">{t(project.status, lang)}</span>}
            {project.tech.slice(0, 6).map((tech) => <span class="chip">{tech}</span>)}
          </div>
          <div style="margin-top:20px;display:flex;flex-wrap:wrap;gap:12px">
            {project.links.github && (
              <a class="btn btn--primary" href={project.links.github.url} target="_blank" rel="noopener noreferrer">
                {t(project.links.github.label, lang)}
                <span class="btn__arrow" aria-hidden="true">↗</span>
              </a>
            )}
            {project.links.demo && (
              <a class="btn btn--secondary" href={project.links.demo.url} target="_blank" rel="noopener noreferrer">
                {t(project.links.demo.label, lang)}
              </a>
            )}
          </div>
        </div>
        {d.demoMedia && (
          <div class="page-hero__media" data-reveal>
            <video controls preload="metadata" poster={d.demoMedia.gif[lang]} style="width:100%;border-radius:12px;border:1px solid var(--hairline);background:#000">
              <source src={d.demoMedia.video[lang]} type="video/mp4" />
            </video>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ============ KEY NUMBERS ============ -->
  {project.stats.length > 0 && (
    <section class="section section--flush" style="padding-bottom:4px">
      <div class="container">
        <StatGrid stats={project.stats} lang={lang} />
      </div>
    </section>
  )}

  <!-- ============ HIGHLIGHTS ============ -->
  <section class="section section--flush" style="padding-top:20px">
    <div class="container">
      <ul class="highlight-grid">
        {d.highlights.map((h) => (
          <li class="card card--plain" style="padding:14px 16px;font-size:0.875rem;line-height:1.6">{t(h, lang)}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ ARCHITECTURE DIAGRAM ============ -->
  <section class="section section--flush" style="padding-top:24px">
    <div class="container">
      <figure class="diagram-figure">
        <img class="diagram" src={`/diagrams/${project.slug}.svg`} alt={t(d.architecture, lang)} loading="lazy" />
        <figcaption>{t(d.architecture, lang)}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ SCREENSHOTS (carousel) ============ -->
  {d.demoMedia && (
    <section class="section section--flush" style="padding-top:24px">
      <div class="container">
        <div class="shot-carousel" data-carousel>
          <button type="button" class="carousel__arrow carousel__arrow--prev" data-prev aria-label="Previous screenshot">‹</button>
          <div class="carousel__viewport">
            {d.demoMedia.shots[lang].map((s, i) => (
              <figure class="carousel__slide" data-slide={i}>
                <img src={s} alt={`${project.name} screenshot ${i + 1}`} loading="lazy" />
                <figcaption class="carousel__num">
                  {i + 1} / {d.demoMedia!.shots[lang].length}
                </figcaption>
              </figure>
            ))}
          </div>
          <button type="button" class="carousel__arrow carousel__arrow--next" data-next aria-label="Next screenshot">›</button>
          <div class="carousel__dots">
            {d.demoMedia.shots[lang].map((_, i) => (
              <button type="button" class="carousel__dot" data-dot={i} aria-label={`Screenshot ${i + 1}`}></button>
            ))}
          </div>
        </div>
        <script>
          const carousel = document.querySelector('[data-carousel]');
          if (carousel) {
            const slides = [...carousel.querySelectorAll('[data-slide]')];
            const dots = [...carousel.querySelectorAll('[data-dot]')];
            let current = 0;
            const show = (i) => {
              current = (i + slides.length) % slides.length;
              slides.forEach((s, k) => s.classList.toggle('is-active', k === current));
              dots.forEach((dd, k) => dd.classList.toggle('is-active', k === current));
            };
            carousel.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
            carousel.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
            dots.forEach((dd, k) => dd.addEventListener('click', () => show(k)));
            show(0);
          }
        </script>
      </div>
    </section>
  )}

  <!-- ============ NEXT PROJECT ============ -->
  {
    (() => {
      const idx = DETAILED_PROJECTS.findIndex((p) => p.slug === slug);
      const next = DETAILED_PROJECTS[(idx + 1) % DETAILED_PROJECTS.length];
      return (
        <section class="section" style="padding-top:28px">
          <div class="container">
            <a class="card card--interactive" style="padding:18px 20px;flex-direction:row;align-items:center;justify-content:space-between;gap:16px" href={`/${lang}/projects/${next.slug}`}>
              <div>
                <div style="font-size:0.75rem;color:var(--ink-subtle);margin-bottom:4px">
                  {t({ en: 'Next project', zh: '下一个项目' }, lang)}
                </div>
                <h3 style="font-family:var(--font-mono);font-size:1rem;font-weight:600;margin:0">{next.name}</h3>
                <p style="color:var(--ink-subtle);font-size:0.8125rem;margin:4px 0 0">{t(next.tagline, lang)}</p>
              </div>
              <span class="link-arrow hide-mobile" aria-hidden="true">
                <span class="arr">→</span>
              </span>
            </a>
          </div>
        </section>
      );
    })()
  }
</Base>
