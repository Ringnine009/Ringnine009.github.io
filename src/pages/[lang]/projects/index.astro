---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { PROJECTS, DETAILED_PROJECTS } from '@/data/projects';
import { siteConfig } from '@/data/site';
import { t, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/projects`;
const title = `${t({ en: 'Projects', zh: '项目' }, lang)}${t(siteConfig.seo.titleSuffix, lang)}`;
const description = t(
  {
    en: 'Five shipped LLM products and one published multi-agent research paper — RAG, document intelligence, agent teams, and a model trained from scratch.',
    zh: '五个成型 LLM 产品与一篇已发表多智能体论文——RAG、文档智能、智能体团队，以及一个从零训练的模型。',
  },
  lang,
);
const rowHref = (slug: string) => `/${lang}/projects/${slug}`;
const researchHref = `/${lang}/research`;
---

<Base lang={lang} title={title} description={description} path={path}>
  <PageHero
    kicker={{ en: 'Portfolio', zh: '作品集' }}
    title={{ en: 'Projects & research', zh: '项目与研究' }}
    lede={{
      en: 'Six display slots: five production-grade LLM projects with case-study pages, plus a published multi-agent research paper.',
      zh: '六个展示位：五个生产级 LLM 项目（各有案例详情页），加一篇已发表的多智能体研究论文。',
    }}
    chips={['6 slots', 'EN / 中文', 'MIT']}
    lang={lang}
  />

  <section class="section section--flush">
    <div class="container">
      <!-- Research entry first (published work) -->
      <div class="card card--interactive" style="margin-bottom:20px" data-reveal>
        <div class="proj-card__top">
          <span class="proj-card__icon" aria-hidden="true">◉</span>
          <h3 class="proj-card__name">
            <a href={researchHref}>{PROJECTS[5].name}</a>
          </h3>
          <div class="proj-card__badges">
            <span class="badge badge--success">{t(PROJECTS[5].status!, lang)}</span>
          </div>
        </div>
        <p class="proj-card__summary">{t(PROJECTS[5].summary, lang)}</p>
        <div class="proj-card__tags">
          {PROJECTS[5].tech.map((tech) => <span class="chip">{tech}</span>)}
        </div>
        <div class="proj-card__foot">
          <span class="link-arrow">
            {t(PROJECTS[5].links.internal, lang)}
            <span class="arr" aria-hidden="true">→</span>
          </span>
          <span class="mono">TNS · Vol.174</span>
        </div>
      </div>

      <!-- Product rows — dense list style -->
      <div style="display:grid;gap:12px">
        {
          DETAILED_PROJECTS.map((p) => (
            <a class="card card--interactive proj-row" href={rowHref(p.slug)} data-reveal>
              <span class="proj-card__icon" style="width:40px;height:40px" aria-hidden="true">{p.glyph}</span>
              <div class="proj-row__main">
                <div class="proj-row__title">
                  <h3 style="font-family:var(--font-mono);font-size:1rem;font-weight:600;letter-spacing:-0.01em">
                    {p.name}
                  </h3>
                  {p.status && <span class="badge badge--primary">{t(p.status, lang)}</span>}
                </div>
                <p style="color:var(--ink-subtle);font-size:0.8125rem;margin-top:4px">{t(p.tagline, lang)}</p>
              </div>
              <div class="proj-row__chips">
                {p.tech.slice(0, 4).map((tech) => <span class="chip">{tech}</span>)}
              </div>
              <span class="link-arrow proj-row__arrow hide-mobile" aria-hidden="true">
                <span class="arr">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
