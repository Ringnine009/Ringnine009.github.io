---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { PROJECTS, DETAILED_PROJECTS } from '@/data/projects';
import { siteConfig } from '@/data/site';
import { t, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/projects`;
const title = `${t({ en: 'Projects', zh: '项目' }, lang)}${t(siteConfig.seo.titleSuffix, lang)}`;
const description = t(
  {
    en: 'Five built LLM products and one published multi-agent research paper — RAG, document intelligence, agent teams, and a model trained from scratch.',
    zh: '五个成型 LLM 产品与一篇已发表多智能体论文——RAG、文档智能、智能体团队，以及一个从零训练的模型。',
  },
  lang,
);
const rowHref = (slug: string) => `/${lang}/projects/${slug}`;
const researchHref = `/${lang}/research`;
---

<Base lang={lang} title={title} description={description} path={path}>
  <PageHero
    kicker={{ en: 'Portfolio', zh: '作品集' }}
    title={{ en: 'Projects & research', zh: '项目与研究' }}
    lede={{
      en: 'Five LLM products with case-study pages, plus a published multi-agent research paper.',
      zh: '五个 LLM 产品（各有案例详情页），加一篇已发表的多智能体研究论文。',
    }}
    chips={['RAG', 'Multi-agent', 'Doc Intelligence', 'Model Training']}
    lang={lang}
  />

  <section class="section section--flush">
    <div class="container">
      <!-- Research entry first (published work) -->
      <a class="card card--interactive" style="margin-bottom:20px;display:block" href={researchHref} data-reveal>
        <div class="proj-card__top">
          <span class="proj-card__icon" aria-hidden="true">◉</span>
          <h3 class="proj-card__name">{PROJECTS[5].name}</h3>
          <div class="proj-card__badges">
            <span class="badge badge--success">{t(PROJECTS[5].status!, lang)}</span>
          </div>
        </div>
        <p class="proj-card__summary">{t(PROJECTS[5].summary, lang)}</p>
        <div class="proj-card__tags">
          {PROJECTS[5].tech.map((tech) => <span class="chip">{tech}</span>)}
        </div>
        <div class="proj-card__foot">
          <span class="link-arrow">
            {t(PROJECTS[5].links.internal, lang)}
            <span class="arr" aria-hidden="true">→</span>
          </span>
          <span class="mono">TNS · Vol.174</span>
        </div>
      </a>

      <!-- Product cards — same structure as the research entry: name + summary + tech stack -->
      <div style="display:grid;gap:16px;margin-top:20px">
        {
          DETAILED_PROJECTS.map((p) => (
            <a class="card card--interactive" href={rowHref(p.slug)} data-reveal style="display:block">
              <div class="proj-card__top">
                <span class="proj-card__icon" aria-hidden="true">{p.glyph}</span>
                <h3 class="proj-card__name">{p.name}</h3>
                {p.status && <div class="proj-card__badges"><span class="badge badge--primary">{t(p.status, lang)}</span></div>}
              </div>
              <p class="proj-card__summary">{t(p.summary, lang)}</p>
              <div class="proj-card__tags">
                {p.tech.map((tech) => <span class="chip">{tech}</span>)}
              </div>
              <div class="proj-card__foot">
                <span class="link-arrow">
                  {t(p.links.internal, lang)}
                  <span class="arr" aria-hidden="true">→</span>
                </span>
                {p.stats && p.stats[0] && (
                  <span class="mono">{p.stats[0].value}{p.stats[0].unit ? ` ${p.stats[0].unit}` : ''}</span>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
