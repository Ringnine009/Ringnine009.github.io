---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { aboutContent as c } from '@/data/about';
import { siteConfig } from '@/data/site';
import { t, langPath, type Lang } from '@/lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/about`;
const title = `${t({ en: 'About', zh: '关于' }, lang)}${t(siteConfig.seo.titleSuffix, lang)}`;
const description = t(c.intro, lang);
---

<Base lang={lang} title={title} description={description} path={path}>
  <PageHero
    kicker={c.kicker}
    title={c.title}
    lede={c.intro}
    chips={['Tongji Univ. · AI · 2023–2027', 'IELTS 7.0']}
    lang={lang}
  />

  <!-- ============ PUBLICATION ============ -->
  <section class="section">
    <div class="container">
      <div class="paper-block" data-reveal>
        <div class="paper-block__title">{t(c.publication.title, lang)}</div>
        <div class="paper-block__meta">
          {c.publication.meta.map((m) => <div>{t(m, lang)}</div>)}
        </div>
        <div style="margin-top:12px">
          <a class="link-arrow" href={langPath(lang, '/research')}>
            {t(c.publication.link, lang)}
            <span class="arr" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section">
    <div class="container">
      <div class="contact-strip" data-reveal>
        <div class="contact-strip__item">
          <span aria-hidden="true">✉</span>
          <a href={`mailto:${c.contact.email}`}>{c.contact.email}</a>
          <button type="button" class="contact-strip__copy" data-copy={c.contact.email} aria-label="Copy email address">
            Copy
          </button>
        </div>
        <div class="contact-strip__item">
          <span aria-hidden="true">☏</span>
          <a href={`tel:${c.contact.phone.replace(/\s/g, '')}`}>{c.contact.phone}</a>
        </div>
        <div class="contact-strip__item">
          <span aria-hidden="true">GitHub</span>
          <a href={c.contact.github} target="_blank" rel="noopener noreferrer">{c.contact.github.replace('https://', '')}</a>
        </div>
      </div>
      <script>
        const copyBtns = document.querySelectorAll('[data-copy]');
        copyBtns.forEach((btn) => {
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(btn.dataset.copy ?? '');
              const old = btn.textContent;
              btn.textContent = '✓ Copied';
              setTimeout(() => (btn.textContent = old), 1600);
            } catch {
              /* clipboard unavailable */
            }
          });
        });
      </script>
    </div>
  </section>
</Base>
